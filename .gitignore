# Publish only bridge/control sources, build inputs and documentation.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/arm64_bridge/
!/controls/

/arm64_bridge/*
!/arm64_bridge/CMakeLists.txt
!/arm64_bridge/src/
!/arm64_bridge/patches/
!/arm64_bridge/third_party/
/arm64_bridge/third_party/*
!/arm64_bridge/third_party/boost
!/arm64_bridge/third_party/dynarmic
/arm64_bridge/patches/*
!/arm64_bridge/patches/dynarmic-android.patch

/controls/*
!/controls/android-input.patch
!/controls/GraphicsSettings.java

# Keep generated files and credentials out even inside allowed source trees.
**/build/
**/build_*/
**/CMakeFiles/
**/__pycache__/
*.apk
*.apks
*.xapk
*.obb
*.dex
*.so
*.a
*.o
*.obj
*.exe
*.dll
*.zip
*.7z
*.png
*.jpg
*.mp4
*.pyc
*.log
*.jks
*.keystore
*.pk8
*.pem
*.crt
*.der
*.p12
*.pfx
.env
.env.*
CMakeCache.txt
compile_commands.json
